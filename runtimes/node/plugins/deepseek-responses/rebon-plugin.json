{
  "name": "deepseek-responses",
  "version": "0.5.0",
  "compatibility": {
    "format": "rebon-plugin",
    "formatVersion": 1,
    "adapterRevision": 1,
    "sdk": [{ "name": "rebon-plugin-api", "range": "^1" }]
  },
  "description": "DeepSeek Responses API model provider (deepseek-v4-pro, deepseek-flash) running as an llm/stream adapter on rebon's plugin plane.",
  "capabilities": {
    "modelProviders": {
      "deepseek": {
        "transport": {
          "type": "plugin",
          "entry": "provider.mjs"
        },
        "capabilities": {
          "forcedToolChoice": true,
          "webSearch": true,
          "anchoredMinimal": true,
          "reasoningText": true,
          "customToolCall": true
        },
        "defaultModel": "deepseek-v4-pro",
        "models": {
          "deepseek-v4-pro": {
            "contextWindow": 1000000,
            "displayName": "DeepSeek V4 Pro"
          },
          "deepseek-flash": {
            "contextWindow": 1000000,
            "displayName": "DeepSeek Flash"
          },
          "deepseek-v4-flash": {
            "contextWindow": 1000000,
            "displayName": "DeepSeek Flash (legacy id)"
          }
        },
        "profiles": {
          "small": "deepseek-flash"
        },
        "displayName": "DeepSeek Responses"
      }
    }
  }
}
